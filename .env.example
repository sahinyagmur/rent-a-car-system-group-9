# Copy to .env (never commit .env) and change the values.
# Used by docker compose and by backend/app.py when run directly.

DB_NAME=rentacar_db
DB_USER=postgres
DB_PASSWORD=change-this-password

# Long random string; generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string

# Port on the host. Use 80 on the server so the site opens with just the IP address.
WEB_PORT=5000

# true only when the site is served over HTTPS
SESSION_COOKIE_SECURE=false
