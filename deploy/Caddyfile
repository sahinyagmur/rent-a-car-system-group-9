# HTTPS in front of the web container (only with: docker compose --profile https up).
# Caddy gets and renews a free Let's Encrypt certificate automatically and
# redirects http:// to https://. DOMAIN comes from .env.

{$DOMAIN} {
	encode gzip
	header Strict-Transport-Security "max-age=31536000"
	reverse_proxy web:5000
}

# www.example.com -> https://example.com
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
